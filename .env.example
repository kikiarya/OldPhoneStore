# Server
PORT=3000
NODE_ENV=development

# SQLite (default — zero-config local / small deploys)
DATABASE_PATH=./data/phones.db

# Optional: PostgreSQL for production (Railway, Render, Supabase, Neon)
# When DATABASE_URL is set, the app can be extended to use Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/oldphonestore

# Public site URL (used in README / future OAuth)
# APP_URL=http://localhost:3000
