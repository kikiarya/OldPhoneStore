# Server
PORT=3000
NODE_ENV=development

# SQLite (default — zero-config local / Docker volume)
DATABASE_PATH=./data/phones.db

# Redis (required for full seckill / cache / chat memory demos)
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=oldphonestore-dev-secret-change-me
JWT_TTL_SEC=604800

# Cart order auto-cancel (minutes)
ORDER_TIMEOUT_MINUTES=15

# ----- Optional LLM for /api/chat (OpenAI-compatible) -----
# Leave unset → local RAG + tools (full demo without any cloud key)
#
# LLM_PROVIDER: openai | deepseek | kimi
# LLM_API_KEY:   your key (also accepts OPENAI_API_KEY / DEEPSEEK_API_KEY / KIMI_API_KEY)
# Optional overrides: LLM_BASE_URL, LLM_MODEL  (or OPENAI_BASE_URL / OPENAI_MODEL)

# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# DeepSeek  https://platform.deepseek.com
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# (default base) https://api.deepseek.com/v1

# Kimi / Moonshot  https://platform.moonshot.cn
# LLM_PROVIDER=kimi
# LLM_API_KEY=sk-...
# LLM_MODEL=moonshot-v1-8k
# (default base) https://api.moonshot.cn/v1
# 长上下文可改: moonshot-v1-32k / moonshot-v1-128k

# Optional Postgres note (not required for this portfolio stack)
# DATABASE_URL=postgresql://user:password@host:5432/oldphonestore
